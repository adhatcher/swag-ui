# Set SWAG_CONFIG_PATH to the host path mapped to /config in your SWAG container.
SWAG_CONFIG_PATH=/mnt/user/appdata/swag
SWAG_CONTAINER_NAME=swag
TAILSCALE_CONTAINER_NAME=
SWAG_UI_BIND_ADDRESS=127.0.0.1
SWAG_UI_PORT=8080
SWAG_UI_ALLOWED_HOSTS=localhost,127.0.0.1
SWAG_UI_COOKIE_SECURE=true
SWAG_UI_ADMIN_PASSWORD=replace-with-a-long-random-password
SWAG_UI_SESSION_SECRET=replace-with-at-least-32-random-characters
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_MODEL=
